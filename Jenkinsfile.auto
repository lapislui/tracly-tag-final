pipeline {
    agent any

    // Triggers for PR and Webhook builds
    // Works with GitHub Webhooks (pull_request event) and Multibranch Pipeline PR discovery
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = 'tracly-tag-final'
        // Tag format: pr-<number>-build-<number> or dev-<number>
        DOCKER_TAG = "${env.CHANGE_ID ? 'pr-' + env.CHANGE_ID + '-build-' + env.BUILD_NUMBER : 'dev-' + env.BUILD_NUMBER}"
        DOCKER_LATEST_TAG = "${env.CHANGE_ID ? 'pr-' + env.CHANGE_ID : 'dev'}"
        DOCKER_REGISTRY_CREDENTIALS_ID = 'docker-hub-credentials'
        DOCKER_REGISTRY_USER = 'luphonixprime'
        
        // Repositories info
        ORG_REPO_URL = 'https://github.com/Luphonix-Prime/tracly-tag-final.git'
        TARGET_BRANCH = "${env.CHANGE_TARGET ?: 'new-try'}"
        SOURCE_BRANCH = "${env.CHANGE_BRANCH ?: 'dockerize'}"
    }

    stages {
        stage('PR & SCM Checkout') {
            steps {
                script {
                    echo "Checking out source code for PR build..."
                    if (env.CHANGE_ID) {
                        echo "Building Pull Request #${env.CHANGE_ID}: ${env.CHANGE_BRANCH} -> ${env.CHANGE_TARGET}"
                    } else {
                        echo "Building Branch: ${env.SOURCE_BRANCH}"
                    }

                    try {
                        // In Multibranch / PR pipeline, checkout scm automatically checks out and merges PR
                        checkout scm
                    } catch (Exception e) {
                        echo "Standard SCM checkout failed, falling back to git clone..."
                        git branch: env.SOURCE_BRANCH, url: env.ORG_REPO_URL
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${env.DOCKER_IMAGE}:${env.DOCKER_TAG} and ${env.DOCKER_IMAGE}:${env.DOCKER_LATEST_TAG}"
                sh "docker build --target runner -t ${env.DOCKER_IMAGE}:${env.DOCKER_TAG} -t ${env.DOCKER_IMAGE}:${env.DOCKER_LATEST_TAG} -t ${env.DOCKER_IMAGE}:latest ."
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    try {
                        echo 'Attempting to push image to Docker Hub...'
                        withCredentials([usernamePassword(credentialsId: env.DOCKER_REGISTRY_CREDENTIALS_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh "echo \${DOCKER_PASS} | docker login -u \${DOCKER_USER} --password-stdin"
                            sh "docker tag ${env.DOCKER_IMAGE}:${env.DOCKER_TAG} ${env.DOCKER_REGISTRY_USER}/${env.DOCKER_IMAGE}:${env.DOCKER_TAG}"
                            sh "docker tag ${env.DOCKER_IMAGE}:${env.DOCKER_LATEST_TAG} ${env.DOCKER_REGISTRY_USER}/${env.DOCKER_IMAGE}:${env.DOCKER_LATEST_TAG}"
                            sh "docker push ${env.DOCKER_REGISTRY_USER}/${env.DOCKER_IMAGE}:${env.DOCKER_TAG}"
                            sh "docker push ${env.DOCKER_REGISTRY_USER}/${env.DOCKER_IMAGE}:${env.DOCKER_LATEST_TAG}"
                        }
                    } catch (Exception e) {
                        echo "Push to Docker Hub skipped or credentials missing. Continuing local deployment..."
                    }
                }
            }
        }

        stage('Deploy to OVH VPS') {
            steps {
                echo 'Deploying application locally on OVH VPS using Docker Compose...'
                sh 'touch .env'
                sh 'docker compose down --remove-orphans'
                sh 'docker compose up -d --build'
                echo 'Application successfully deployed and running on OVH VPS!'
            }
        }
    }

    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
        success {
            echo "PR / Build #${env.BUILD_NUMBER} successfully built and deployed to OVH VPS!"
        }
        failure {
            echo "Pipeline failed for PR / Build #${env.BUILD_NUMBER}. Please check Jenkins console output."
        }
    }
}

